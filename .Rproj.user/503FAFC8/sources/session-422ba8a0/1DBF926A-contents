  mutate(europe = continent == "Europe")

nb_europe <- sum(top_pnb$europe)

ggplot(top_pnb, aes(x = PNB, y = fct_reorder(pays, PNB), fill = europe)) +
  geom_col() +
  geom_text(aes(label = scales::label_dollar(big.mark = " ")(PNB)), hjust = -0.1, size = 3) +
  scale_fill_manual(values = c(`TRUE` = "firebrick", `FALSE` = "grey70"),
